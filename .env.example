# ──────────────────────────────────────────────────────────────
# Never Forget Occasions — Environment Variables Template
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# IMPORTANT: Never commit your real .env file to version control.
# ──────────────────────────────────────────────────────────────

# Supabase Project URL
VITE_SUPABASE_URL=https://zmipvtryvnwrbzqnludu.supabase.co

# Supabase Anon (public) key — safe to expose in the browser
# Find this in: Supabase Dashboard → Project Settings → API → Project API Keys
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role key — NEVER prefix with VITE_, NEVER expose to the browser
# Use only in Edge Functions, server-side scripts, or admin tooling
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
